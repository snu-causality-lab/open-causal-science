module
public import OpenCausalScience.Papers.Pearl1995.RuleTwoMoralization

/-! # Marginalizing nonancestors in a finite factorized DAG

For a normalized binary node kernel, removing a childless coordinate
is exact: only its own factor involves its value, and summing that
factor gives one. On the complement of an ancestral set, visiting a
highest-ranked remaining vertex always gives such a removal. This is
the marginalization step preceding the moral-graph argument in
`RuleTwoMoralization`.
-/

namespace OpenCausalScience.Papers.Pearl1995.AncestralFactorization

open RuleTwoMoralization

@[expose] public section

variable {n : Nat} {G : DAG n}

def assign (s : Assignment n) (v : Fin n) (b : Bool) : Assignment n :=
  fun u => if u = v then b else s u

def Normalized (factor : Fin n → Assignment n → Rat) : Prop :=
  ∀ v s, factor v (assign s v false) + factor v (assign s v true) = 1

def product (factor : Fin n → Assignment n → Rat) (vertices : List (Fin n))
    (s : Assignment n) : Rat :=
  (vertices.map fun v => factor v s).prod

def eliminateOne (v : Fin n) (weight : Assignment n → Rat) (s : Assignment n) : Rat :=
  weight (assign s v false) + weight (assign s v true)

def eliminate (order : List (Fin n)) (weight : Assignment n → Rat) : Assignment n → Rat :=
  match order with
  | [] => weight
  | v :: rest => eliminate rest (eliminateOne v weight)

def enumerate (order : List (Fin n)) (s : Assignment n) : List (Assignment n) :=
  match order with
  | [] => [s]
  | v :: rest => (enumerate rest s).flatMap fun row => [assign row v false, assign row v true]

private theorem sum_expand (rows : List (Assignment n)) (v : Fin n) (weight : Assignment n → Rat) :
    ((rows.flatMap fun row => [assign row v false, assign row v true]).map weight).sum =
      (rows.map (eliminateOne v weight)).sum := by
  induction rows with
  | nil => simp
  | cons row rest ih =>
    simp [ih, eliminateOne, Rat.add_assoc]

/-- Elimination sums a cell over all assignments of the removed
coordinates, as generated by the recursive Boolean enumeration. -/
theorem eliminate_eq_sum (order : List (Fin n)) (weight : Assignment n → Rat) (s : Assignment n) :
    eliminate order weight s = ((enumerate order s).map weight).sum := by
  induction order generalizing weight with
  | nil => simp [eliminate, enumerate, Rat.add_zero]
  | cons v rest ih =>
    simp only [eliminate, enumerate, ih, sum_expand]

private theorem prod_perm {left right : List Rat} (h : left.Perm right) :
    left.prod = right.prod := by
  induction h with
  | nil => rfl
  | cons _ _ ih => simp only [List.prod_cons, ih]
  | swap a b tail =>
    simp only [List.prod_cons]
    rw [← Rat.mul_assoc, ← Rat.mul_assoc, Rat.mul_comm a b]
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

private theorem product_erase (factor : Fin n → Assignment n → Rat) (vertices : List (Fin n))
    (v : Fin n) (member : v ∈ vertices) (s : Assignment n) :
    product factor vertices s = factor v s * product factor (vertices.erase v) s :=
  prod_perm ((List.perm_cons_erase member).map fun u => factor u s)

/-- Summing a sink's two values removes its own normalized factor and
keeps every other remaining factor. -/
theorem eliminate_sink {factor : Fin n → Assignment n → Rat}
    (locality : FactorLocal G factor) (normalized : Normalized factor)
    {vertices : List (Fin n)} (unique : vertices.Nodup) {v : Fin n} (member : v ∈ vertices)
    (sink : ∀ u ∈ vertices.erase v, G.edge v u = false) :
    eliminateOne v (product factor vertices) = product factor (vertices.erase v) := by
  funext s
  have remaining (b : Bool) : product factor (vertices.erase v) (assign s v b) =
      product factor (vertices.erase v) s := by
    unfold product
    apply congrArg List.prod
    apply List.map_congr_left
    intro u hu
    apply locality
    intro i inScope
    have other : i ≠ v := by
      intro same
      subst i
      obtain equal | edge := inScope
      · exact unique.not_mem_erase (equal.symm ▸ hu)
      · exact Bool.noConfusion ((sink u hu).symm.trans edge)
    simp [assign, other]
  unfold eliminateOne
  rw [product_erase factor vertices v member, product_erase factor vertices v member,
    remaining false, remaining true, ← Rat.add_mul, normalized v s, Rat.one_mul]

def Ancestral (G : DAG n) (keep : Fin n → Bool) : Prop :=
  ∀ u v, G.edge u v = true → keep v = true → keep u = true

private theorem remove_omitted_never_filters {keep : Fin n → Bool} {v : Fin n}
    (outside : keep v = false) (vertices : List (Fin n)) :
    (vertices.erase v).filter keep = vertices.filter keep := by
  induction vertices with
  | nil => rfl
  | cons u rest ih =>
    by_cases same : u = v
    · subst u
      simp [outside]
    · simp only [List.erase_cons, beq_iff_eq, same, ↓reduceIte, List.filter_cons, ih]

private theorem max_rank_exists (G : DAG n) (vertices : List (Fin n))
    (nonempty : vertices ≠ []) : ∃ v ∈ vertices, ∀ u ∈ vertices, G.rank u ≤ G.rank v := by
  induction vertices with
  | nil => exact (nonempty rfl).elim
  | cons first rest ih =>
    by_cases empty : rest = []
    · subst rest
      refine ⟨first, List.mem_cons_self, ?_⟩
      intro u hu
      simp [List.mem_singleton.mp hu]
    · obtain ⟨v, hv, bound⟩ := ih empty
      by_cases higher : G.rank v ≤ G.rank first
      · refine ⟨first, List.mem_cons_self, ?_⟩
        intro u hu
        obtain equal | later := List.mem_cons.mp hu
        · simp [equal]
        · exact Nat.le_trans (bound u later) higher
      · refine ⟨v, List.mem_cons_of_mem _ hv, ?_⟩
        intro u hu
        obtain equal | later := List.mem_cons.mp hu
        · subst u
          omega
        · exact bound u later

/-- A DAG's ancestral marginal keeps exactly the factors in its
ancestral set. The summation order contains each omitted vertex once. -/
theorem ancestral_marginal_eq_product {factor : Fin n → Assignment n → Rat}
    (locality : FactorLocal G factor) (normalized : Normalized factor)
    (keep : Fin n → Bool) (ancestral : Ancestral G keep) (vertices : List (Fin n))
    (unique : vertices.Nodup) :
    ∃ order : List (Fin n), order.Nodup ∧ (∀ v, v ∈ order ↔ v ∈ vertices ∧ keep v = false) ∧
      eliminate order (product factor vertices) = product factor (vertices.filter keep) := by
  induction measure : vertices.length using Nat.strongRecOn generalizing vertices with
  | ind k ih =>
    let omitted := vertices.filter fun u => !(keep u)
    by_cases none : omitted = []
    · have allKept : ∀ v ∈ vertices, keep v = true := by
        intro v hv
        cases isKept : keep v with
        | true => rfl
        | false =>
          have ho : v ∈ omitted := List.mem_filter.mpr ⟨hv, by simp [isKept]⟩
          simp [none] at ho
      refine ⟨[], List.nodup_nil, ?_, ?_⟩
      · intro v
        constructor
        · intro hv
          cases hv
        · intro ⟨hv, outside⟩
          exact (Bool.noConfusion ((allKept v hv).symm.trans outside))
      · rw [List.filter_eq_self.mpr allKept]
        rfl
    · obtain ⟨v, hv, bound⟩ := max_rank_exists G omitted none
      obtain ⟨hv', discard⟩ := List.mem_filter.mp hv
      have outside : keep v = false := by
        simpa using discard
      have terminal : ∀ u ∈ vertices.erase v, G.edge v u = false := by
        intro u hu
        cases edge : G.edge v u with
        | false => rfl
        | true =>
          have notKept : keep u = false := Bool.eq_false_iff.mpr (fun kept =>
            Bool.noConfusion (outside.symm.trans (ancestral v u edge kept)))
          have uOmitted : u ∈ omitted :=
            List.mem_filter.mpr ⟨List.mem_of_mem_erase hu, by simp [notKept]⟩
          have rank := G.edge_increases v u edge
          have limit := bound u uOmitted
          omega
      have smaller : (vertices.erase v).length < k := by
        have reduction := List.length_erase_of_mem hv'
        have positive : 0 < vertices.length := List.length_pos_of_mem hv'
        omega
      obtain ⟨rest, restUnique, restMembers, restEq⟩ :=
        ih _ smaller (vertices.erase v) (unique.erase v) rfl
      refine ⟨v :: rest, List.nodup_cons.mpr ⟨?_, restUnique⟩, ?_, ?_⟩
      · intro repeated
        exact unique.not_mem_erase ((restMembers v).mp repeated).1
      · intro u
        constructor
        · intro hu
          obtain equal | later := List.mem_cons.mp hu
          · exact equal.symm ▸ ⟨hv', outside⟩
          · obtain ⟨before, excluded⟩ := (restMembers u).mp later
            exact ⟨List.mem_of_mem_erase before, excluded⟩
        · intro ⟨hu, exclude⟩
          by_cases equal : u = v
          · exact List.mem_cons.mpr (.inl equal)
          · exact List.mem_cons.mpr (.inr ((restMembers u).mpr
              ⟨(List.mem_erase_of_ne equal).mpr hu, exclude⟩))
      · simp only [eliminate, eliminate_sink locality normalized unique hv' terminal]
        rw [restEq, remove_omitted_never_filters outside]

theorem enumerate_agrees_outside (order : List (Fin n)) (s row : Assignment n)
    (member : row ∈ enumerate order s) {v : Fin n} (retained : v ∉ order) :
    row v = s v := by
  induction order generalizing row with
  | nil =>
    have equal : row = s := List.mem_singleton.mp member
    rw [equal]
  | cons u rest ih =>
    have distinct : v ≠ u := fun same => retained (List.mem_cons.mpr (.inl same))
    have notLater : v ∉ rest := fun later => retained (List.mem_cons_of_mem _ later)
    obtain ⟨before, beforeMem, casesRow⟩ := List.mem_flatMap.mp member
    have prior := ih before beforeMem notLater
    rcases List.mem_cons.mp casesRow with row₀ | row₁
    · rw [row₀]
      simpa [assign, distinct] using prior
    · rw [List.mem_singleton.mp row₁]
      simpa [assign, distinct] using prior

open Moralization

def ReadsRelevant (Q : Query G) (event : Assignment n → Bool) : Prop :=
  ∀ first second, (∀ v, Q.relevant v → first v = second v) → event first = event second

/-- The full joint table at fixed evidence, summing over both endpoint
blocks and over the removed coordinates. Each row uses the product of
all node factors before marginalization. -/
noncomputable def fullMass (table : Table G) (Q : Query G) (w : Assignment n)
    (order : List (Fin n)) (event : Assignment n → Bool) : Rat :=
  (table.leftRows.map fun l =>
    (table.rightRows.map fun r =>
      ((enumerate order (merge Q w l r)).map fun s =>
        if event s then product table.factor (List.finRange n) s else 0).sum).sum).sum

/-- For normalized local kernels, summing the full joint over all
nonancestors gives exactly the ancestor-factor table. This identity
holds for every event that reads only ancestor coordinates. -/
theorem exists_full_sum_for_ancestral_mass (table : Table G) (Q : Query G)
    (normalized : Normalized table.factor) :
    ∃ order : List (Fin n), order.Nodup ∧ (∀ v, v ∈ order ↔ ¬ Q.relevant v) ∧
      ∀ w event, ReadsRelevant Q event →
        fullMass table Q w order event = table.marginMass Q w event := by
  classical
  let keep : Fin n → Bool := fun v => decide (Q.relevant v)
  have ancestral : Ancestral G keep := by
    intro u v edge h
    obtain ⟨w, hw, path⟩ := (Q.relevant_iff v).mp (of_decide_eq_true h)
    exact decide_eq_true ((Q.relevant_iff u).mpr ⟨w, hw, DAG.ancestor_of_edge edge path⟩)
  obtain ⟨order, unique, removed, weights⟩ := ancestral_marginal_eq_product
    table.locality normalized keep ancestral (List.finRange n) (List.nodup_finRange n)
  have removal (v : Fin n) : v ∈ order ↔ ¬ Q.relevant v := by
    rw [removed]
    simp [keep]
  refine ⟨order, unique, removal, ?_⟩
  intro w event reads
  unfold fullMass Table.marginMass
  apply congrArg List.sum
  apply List.map_congr_left
  intro l _
  apply congrArg List.sum
  apply List.map_congr_left
  intro r _
  let row := merge Q w l r
  change ((enumerate order row).map fun s =>
    if event s then product table.factor (List.finRange n) s else 0).sum =
      if event row then product table.factor (relevantVertices Q) row else 0
  have sameEvent (s : Assignment n) (hs : s ∈ enumerate order row) :
      event s = event row := by
    apply reads
    intro v relevant
    exact enumerate_agrees_outside order row s hs (fun member => ((removal v).mp member) relevant)
  cases holds : event row with
  | false =>
    simp only [List.map_congr_left (fun s hs => by simp [sameEvent s hs, holds] :
      ∀ s ∈ enumerate order row, (if event s then product table.factor (List.finRange n) s
        else 0) = 0), Bool.false_eq_true, ↓reduceIte]
    have zero (rows : List (Assignment n)) : (rows.map (fun _ => (0 : Rat))).sum = 0 := by
      induction rows with
      | nil => rfl
      | cons _ rest ih => simp [ih, Rat.add_zero]
    exact zero (enumerate order row)
  | true =>
    have terms : (enumerate order row).map (fun s =>
        if event s then product table.factor (List.finRange n) s else 0) =
        (enumerate order row).map (product table.factor (List.finRange n)) := by
      apply List.map_congr_left
      intro s hs
      simp [sameEvent s hs, holds]
    simp only [terms, ↓reduceIte]
    rw [← eliminate_eq_sum, weights]
    rfl

/-- A full cut-regime joint tabulation represents the same response
events for any ordering of the nonancestor coordinates. The canonical retained rows are supplied in the table. -/
def MatchesFullResponses {Ω Z Y W : Type} [DecidableEq W]
    (table : Table G) (Q : Query G) (model : RuleTwo.Model Ω Z Y W)
    (z : Z) (w : W) (evidence : Assignment n)
    (leftReadout : Assignment n → Z) (rightReadout : Assignment n → Y) : Prop :=
  ∀ order : List (Fin n), order.Nodup → (∀ v, v ∈ order ↔ ¬ Q.relevant v) →
    ∀ (p : Z → Bool) (q : Y → Bool),
      model.mass (fun atom => decide ((model.respond z atom).2 = w) &&
        (p (model.observe atom) && q (model.respond z atom).1)) =
        fullMass table Q evidence order (fun s => p (leftReadout s) && q (rightReadout s))

theorem matches_ancestral_margin_of_full_joint {Ω Z Y W : Type} [DecidableEq W]
    (table : Table G) (Q : Query G) (model : RuleTwo.Model Ω Z Y W)
    (z : Z) (w : W) (evidence : Assignment n)
    (leftReadout : Assignment n → Z) (rightReadout : Assignment n → Y)
    (leftReads : ReadsOnly Q.left leftReadout) (rightReads : ReadsOnly Q.right rightReadout)
    (normalized : Normalized table.factor)
    (full : MatchesFullResponses table Q model z w evidence leftReadout rightReadout) :
    MatchesResponses table Q model z w evidence leftReadout rightReadout := by
  obtain ⟨order, unique, omitted, sumEq⟩ := exists_full_sum_for_ancestral_mass table Q normalized
  intro p q
  apply (full order unique omitted p q).trans
  apply sumEq
  intro first second agree
  have left : leftReadout first = leftReadout second :=
    leftReads _ _ (fun v member => agree v ((Q.relevant_iff v).mpr ⟨v, .inl member, .inl rfl⟩))
  have right : rightReadout first = rightReadout second :=
    rightReads _ _ (fun v member => agree v ((Q.relevant_iff v).mpr ⟨v, .inr (.inl member), .inl rfl⟩))
  simp only [left, right]

/-- Rule 2 in a cut-regime response model with a normalized binary DAG
factorization of its full joint table. The graphical and marginal
probability steps are derived. The initial factorization is the
remaining probability-model premise. -/
theorem supported_rule_two_of_factorized_joint {Ω Z Y W : Type}
    [DecidableEq Z] [DecidableEq Y] [DecidableEq W]
    (table : Table G) (Q : Query G) (model : RuleTwo.Model Ω Z Y W)
    (z : Z) (y : Y) (w : W) (evidence : Assignment n)
    (leftReadout : Assignment n → Z) (rightReadout : Assignment n → Y)
    (leftReads : ReadsOnly Q.left leftReadout) (rightReads : ReadsOnly Q.right rightReadout)
    (leftOutside : ∀ v, Q.left v = true → Q.condition.member v = false)
    (rightOutside : ∀ v, Q.right v = true → Q.condition.member v = false)
    (separated : ¬ Q.DConnection) (normalized : Normalized table.factor)
    (full : MatchesFullResponses table Q model z w evidence leftReadout rightReadout)
    (observed : 0 < model.observationalCovariateMass z w) (action : 0 < model.setCovariateMass z w) :
    model.setJointMass z y w / model.setCovariateMass z w =
      model.observationalJointMass z y w / model.observationalCovariateMass z w :=
  supported_rule_two_of_factorized_ancestral_margin table Q model z y w evidence
    leftReadout rightReadout leftReads rightReads leftOutside rightOutside separated
    (matches_ancestral_margin_of_full_joint table Q model z w evidence leftReadout rightReadout
      leftReads rightReads normalized full) observed action

end

end OpenCausalScience.Papers.Pearl1995.AncestralFactorization
